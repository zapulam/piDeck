# Copy to .env and fill in. Never commit .env.

# Shared secret for anything that isn't the Pi's own browser (the hooks send it as a Bearer token).
# Leave it empty and piDeck creates one on first start and saves it here.
PIDECK_TOKEN=

# Spotify (https://developer.spotify.com/dashboard) - run `python -m pideck.spotify_auth` once to get the refresh token
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Slack app with Socket Mode enabled (see README)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

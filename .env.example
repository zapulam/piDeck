# Copy to .env and fill in. Never commit .env.

# Administrator credential for a display, including local browsers. Never give this to hooks.
# Source/Pi installs generate private values here; desktop packages use the OS credential vault.
PIDECK_TOKEN=
# Event-only credential for Claude Code / Codex / Cursor hooks; cannot read Slack or control playback.
PIDECK_HOOK_TOKEN=

# Spotify: add your client ID, then connect in desktop Settings or run python -m pideck.spotify_auth.
# PKCE does not require a client secret. Leave it only for existing secret-based authorizations.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Slack app with Socket Mode enabled (see README)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
